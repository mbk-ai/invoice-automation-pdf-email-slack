    {
      "parameters": {
        "jsCode": "const row = $('Set - Prepare Invoice Data').item.json;\nconst docFile = $input.first().json;\n\nconst fields = ['invoice_id', 'invoice_date', 'company', 'address', 'item_line', 'due_date', 'subtotal', 'tax', 'total'];\n\nconst requests = fields.map((field) => ({\n  replaceAllText: {\n    containsText: { text: `{{${field}}}`, matchCase: true },\n    replaceText: String(row[field] ?? '')\n  }\n}));\n\nreturn [{\n  json: {\n    ...docFile,\n    docsApiBody: JSON.stringify({ requests })\n  }\n}];"
      },
