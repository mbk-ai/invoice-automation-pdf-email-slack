    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nconst qty = Number(row['Qty'] || 0);\nconst unitPrice = Number(row['Unit Price'] || 0);\nconst taxPercent = Number(row['Tax %'] || 0);\n\nconst subtotal = qty * unitPrice;\nconst tax = subtotal * (taxPercent / 100);\nconst total = subtotal + tax;\n\nconst itemLine = `${row['Item']}  |  Qty: ${qty}  |  Unit Price: $${unitPrice.toFixed(2)}  |  Amount: $${subtotal.toFixed(2)}`;\n\nreturn [{\n  json: {\n    ...row,\n    subtotal: subtotal.toFixed(2),\n    tax: tax.toFixed(2),\n    total: total.toFixed(2),\n    item_line: itemLine\n  }\n}];"
      },
